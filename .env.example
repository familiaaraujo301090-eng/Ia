# Chave da API da Anthropic (Claude). Sem ela o app roda em modo demonstração.
ANTHROPIC_API_KEY=
# Modelo (padrão: claude-opus-5-5)
CLAUDE_MODEL=claude-opus-5-5
PORT=3000
# Caminho do banco SQLite (use um disco persistente em produção)
DB_PATH=./data/rumo.db
# Fuso horário usado para "hoje"
TZ_APP=America/Sao_Paulo
# Limite de pedidos à IA por usuário por minuto
AI_PER_MINUTE=20
NODE_ENV=production
# Planos e limites
FREE_AI_PER_DAY=30
PRO_AI_PER_DAY=300
PRO_CHECKOUT_URL=
# Código para virar admin em #/admin (mínimo 20 caracteres)
ADMIN_SECRET=
# Endereço público (OBRIGATÓRIO em produção), ex: https://rumo.onrender.com
APP_URL=
SMTP_URL=
MAIL_FROM=Rumo <no-reply@rumo.app>
# Segurança
TRUST_PROXY=1
REGISTER_PER_HOUR=10
